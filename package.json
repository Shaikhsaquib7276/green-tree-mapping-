{
  "name": "greenmap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "npm run dev --workspace=greenmap-server",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "preview": "vite preview",
    "lint": "oxlint",
    "admin:create": "npm run admin:create --workspace=greenmap-server",
    "admin:reset": "npm run admin:reset --workspace=greenmap-server",
    "data:import-summary": "npm run data:import-summary --workspace=greenmap-server",
    "test": "npm test --workspace=greenmap-server"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "maplibre-gl": "^6.15.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.79.0"
  }
}
